{
  "name": "wikilean-wiki",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:corpus": "node scripts/check-corpus-tests.mjs && vitest run --config vitest.corpus.config.ts",
    "test:e2e": "playwright test",
    "test:ci": "npm run typecheck && npm run test:unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed:sql": "node --experimental-strip-types scripts/seed.ts",
    "seed:delta": "node --experimental-strip-types scripts/seed-delta.ts",
    "seed:refresh": "node --experimental-strip-types scripts/seed-refresh.ts",
    "pull": "node --experimental-strip-types scripts/pull-annotations.ts",
    "backfill-ids": "node --experimental-strip-types scripts/backfill-ids.ts",
    "backfill-counts": "node --experimental-strip-types scripts/backfill-counts.ts",
    "build:decl-index": "node --experimental-strip-types scripts/build-decl-index.ts",
    "build:suffix-index": "node --experimental-strip-types scripts/build-suffix-index.ts",
    "build:premise-index": "node --experimental-strip-types scripts/build-premise-index.ts",
    "build:indexes": "DECL_DATA_CACHE=../catalog/.cache/declaration-data.json npm run build:decl-index && npm run build:suffix-index && npm run build:premise-index",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "backup:d1": "bash scripts/backup-d1.sh",
    "tail": "wrangler tail --format=pretty"
  },
  "dependencies": {
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@hono/node-server": "^1.19.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.107.0"
  }
}
