{
  "schema": "wikilean.reducer-input-inventory/v1",
  "scope": [
    "brain/build_snapshot.py",
    "brain/build_common.py",
    "brain/build_context.py",
    "brain/build_cells.py",
    "brain/layout.py",
    "brain/build_frontier.py",
    "brain/build_cell_shards.py",
    "brain/build_shards.py",
    "brain/stage_io.py",
    "brain/store.py",
    "brain/frontier_suitability.py",
    "site/build_brain_page.py"
  ],
  "classes": {
    "curated_git_input": "Reviewed repository content whose exact Git bytes are an accepted reducer input.",
    "immutable_source_object": "Acquired or generated source bytes that must be named by a verified source manifest and offline pack before authoritative replay.",
    "forbidden_ambient_state": "State that authoritative reduction must not consult unless converted into an explicitly declared immutable object or reducer configuration."
  },
  "inputs": [
    {"path": "catalog/data/source_registry.json", "class": "curated_git_input", "consumers": ["brain/build_common.py", "brain/build_shards.py"], "purpose": "provenance, licensing, external-source policy"},
    {"path": "catalog/data/rebuild_grounding.json", "class": "curated_git_input", "consumers": ["brain/build_common.py"], "purpose": "reviewed concept-to-declaration grounding audit trail"},
    {"path": "catalog/data/grounding_overrides.jsonl", "class": "curated_git_input", "consumers": ["brain/build_cells.py"], "purpose": "reviewed grounding and match-kind corrections"},
    {"path": "catalog/data/universe_extension.jsonl", "class": "curated_git_input", "consumers": ["brain/build_common.py"], "purpose": "reviewed extensions to the concept universe"},
    {"path": "catalog/data/decl_renames.jsonl", "class": "curated_git_input", "consumers": ["brain/build_common.py"], "purpose": "reviewed declaration rename mappings"},
    {"path": "brain/data/container_links.jsonl", "class": "curated_git_input", "consumers": ["brain/build_common.py"], "purpose": "reviewed concept-to-container links"},
    {"path": "brain/data/discovery_proposals.jsonl", "class": "curated_git_input", "consumers": ["brain/build_common.py"], "purpose": "verified discovery fold-ins"},
    {"path": "brain/data/discovery_rejected.jsonl", "class": "curated_git_input", "consumers": ["brain/build_cells.py"], "purpose": "reviewed discovery rejections excluded from cell bonds"},
    {"path": "brain/data/ext_anchor_links.jsonl", "class": "curated_git_input", "consumers": ["brain/build_common.py"], "purpose": "reviewed external-page anchors; optional in the current build"},
    {"path": "brain/data/fc_links.jsonl", "class": "curated_git_input", "consumers": ["brain/build_common.py"], "purpose": "verified FormalConjectures joins"},
    {"path": "catalog/data/tauceti_links.jsonl", "class": "curated_git_input", "consumers": ["brain/build_common.py"], "purpose": "verified TauCeti joins; optional in the current build"},
    {"path": "brain/data/community_edges.jsonl", "class": "curated_git_input", "consumers": ["brain/build_shards.py"], "purpose": "graduated D1 edge snapshot"},
    {"path": "brain/data/frontier_suitability_overrides.jsonl", "class": "curated_git_input", "consumers": ["brain/build_frontier.py"], "purpose": "reviewed frontier queue overrides"},
    {"path": "bot/state/cut_log.json", "class": "curated_git_input", "consumers": ["brain/build_cells.py"], "purpose": "reviewed rejected grounding claims"},
    {"path": "bot/state/seed_queue.json", "class": "curated_git_input", "consumers": ["brain/build_cells.py"], "purpose": "tag queue claims"},
    {"path": "bot/state/recycle_queue.json", "class": "curated_git_input", "consumers": ["brain/build_cells.py"], "purpose": "recycled tag queue claims"},
    {"path": "bot/state/brain_queue.json", "class": "curated_git_input", "consumers": ["brain/build_cells.py"], "purpose": "Brain-origin tag queue claims"},
    {"path": "bot/state/pool_candidates.json", "class": "curated_git_input", "consumers": ["brain/build_cells.py"], "purpose": "optional tag pool claims; absence must be explicit in a pack"},

    {"path": "catalog/data/concept_graph_v2.json", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "derived concept graph input"},
    {"path": "catalog/data/hierarchy.json", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "library and module hierarchy"},
    {"path": "catalog/data/wikidata_universe.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "Wikidata concept universe"},
    {"path": "catalog/data/wikidata_crossrefs.json", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "Wikidata cross-reference identifiers"},
    {"path": "catalog/data/wikidata_descriptions.json", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "Wikidata descriptions"},
    {"path": "catalog/data/theoremgraph_links.json", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "TheoremGraph literature links"},
    {"path": "catalog/data/decl_qid_roles_v2.json", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "annotation-derived declaration roles"},
    {"path": "catalog/data/decl_to_qid_v2.json", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "declaration-to-QID mapping"},
    {"path": "catalog/mathlib_deps/wikidata_edges.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "Wikidata relationship edges"},
    {"path": "catalog/.cache/theorem_matching.csv", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "TheoremGraph matched statements"},
    {"path": "catalog/.cache/statement_formal.csv", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "TheoremGraph formal statements"},
    {"path": "catalog/.cache/slogan.csv", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "licensed declaration slogans; optional in the current build"},
    {"path": "catalog/data/mathlib_tag_xrefs.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "harvested Mathlib source tags"},
    {"path": "catalog/data/formal_conjectures.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "FormalConjectures repository harvest"},
    {"path": "catalog/data/erdos_joins.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "Erdos problem joins"},
    {"path": "catalog/data/tauceti.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "TauCeti repository harvest"},
    {"path_pattern": "catalog/data/user_repos/*.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "enabled user Lean repository harvests; exact members must be enumerated in the pack"},
    {"path_pattern": "catalog/data/external/*_pages.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "external database page harvests; exact members must be enumerated in the pack"},
    {"path_pattern": "catalog/data/external/*_links.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "external database link harvests; exact members must be enumerated in the pack"},
    {"path": "catalog/data/external/arxiv_citations.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "OpenAlex bibliography links"},
    {"path_pattern": "site/annotations/*.json", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "sealed D1 annotation snapshot; exact members must be enumerated in the pack"},
    {"path": "catalog/data/concept_layer.jsonl", "class": "immutable_source_object", "consumers": ["brain/build_frontier.py"], "purpose": "secondary-only concept classification"},
    {"path_pattern": "mathlib4/Mathlib/**/*.lean", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "Mathlib statement snippets; seal the exact checkout tree at a full commit"},
    {"path_pattern": "mathlib4/.lake/build/lib/lean/**/*.ilean", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "compiled declaration index fallback; seal toolchain and exact members"},
    {"path": ".claude/skills/mathlib-search/.cache/declaration-data.json", "class": "immutable_source_object", "consumers": ["brain/build_common.py"], "purpose": "doc-gen declaration oracle"},

    {"name": "network access", "class": "forbidden_ambient_state", "consumers": ["all reducers"], "replacement": "perform acquisition before reduction and include fetched bytes in the offline pack"},
    {"name": "current wall clock", "class": "forbidden_ambient_state", "consumers": ["brain/build_cells.py"], "replacement": "derive audit timestamps outside logical content and exclude them from logical hashes"},
    {"name": "filesystem mtimes as identity", "class": "forbidden_ambient_state", "consumers": ["brain/build_common.py"], "replacement": "use manifest SHA-256 and native immutable revisions; retain mtimes only as audit metadata"},
    {"name": "BRAIN_MATHLIB_CHECKOUT", "class": "forbidden_ambient_state", "consumers": ["brain/build_common.py"], "replacement": "offline-pack path to a sealed Mathlib source object"},
    {"name": "BRAIN_DECL_ORACLE", "class": "forbidden_ambient_state", "consumers": ["brain/build_common.py"], "replacement": "offline-pack path to a sealed declaration-index object"},
    {"name": "BRAIN_EXTERNAL_DIR", "class": "forbidden_ambient_state", "consumers": ["brain/build_common.py"], "replacement": "offline-pack paths enumerated in source manifests"},
    {"name": "BRAIN_EXT_NODE_CAP", "class": "forbidden_ambient_state", "consumers": ["brain/build_common.py"], "replacement": "versioned reducer configuration object"},
    {"name": "undeclared glob members", "class": "forbidden_ambient_state", "consumers": ["brain/build_common.py"], "replacement": "explicit sorted object list in an offline pack"},
    {"name": "undeclared optional-file presence", "class": "forbidden_ambient_state", "consumers": ["brain/build_common.py", "brain/build_cells.py", "brain/build_frontier.py", "brain/build_shards.py"], "replacement": "explicit present/absent source-set contract"},
    {"name": "mutable D1 state", "class": "forbidden_ambient_state", "consumers": ["all reducers"], "replacement": "sealed annotation/community-edge snapshot with immutable digest"},
    {"name": "locale, randomness, and unlisted caches", "class": "forbidden_ambient_state", "consumers": ["all reducers"], "replacement": "fixed reducer environment and complete offline-pack closure"}
  ]
}
