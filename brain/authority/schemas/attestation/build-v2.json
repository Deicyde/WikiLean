{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikilean.invalid/brain/authority/schemas/attestation/build-v2.json",
  "title": "WikiLean full offline replay build attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attestation_id",
    "release_id",
    "build_kind",
    "builder",
    "inputs",
    "output_root",
    "artifacts",
    "metrics"
  ],
  "properties": {
    "schema": {"const": "wikilean.build-attestation/v2"},
    "attestation_id": {"$ref": "#/$defs/hash"},
    "release_id": {"$ref": "#/$defs/hash"},
    "build_kind": {"const": "full-offline-replay"},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "git_commit",
        "configuration_sha256",
        "environment_sha256",
        "network"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "configuration_sha256": {"$ref": "#/$defs/digest"},
        "environment_sha256": {"$ref": "#/$defs/digest"},
        "network": {"const": "disabled"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_root",
        "source_set_root",
        "offline_pack_id",
        "reducer_inventory_id",
        "prior_state_root"
      ],
      "properties": {
        "authority_root": {"$ref": "#/$defs/hash"},
        "source_set_root": {"$ref": "#/$defs/hash"},
        "offline_pack_id": {"$ref": "#/$defs/hash"},
        "reducer_inventory_id": {"$ref": "#/$defs/hash"},
        "prior_state_root": {
          "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        }
      }
    },
    "output_root": {"$ref": "#/$defs/hash"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifactDigest"}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "sha256", "bytes"],
      "properties": {
        "logical_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "logical_root": {
          "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        }
      }
    }
  }
}
