{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikilean.invalid/brain/authority/schemas/attestation/build-v1.json",
  "title": "WikiLean immutable build attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attestation_id",
    "release_id",
    "builder",
    "input_roots",
    "output_root",
    "artifacts",
    "metrics"
  ],
  "properties": {
    "schema": {"const": "wikilean.build-attestation/v1"},
    "attestation_id": {"$ref": "#/$defs/hash"},
    "release_id": {"$ref": "#/$defs/hash"},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "git_commit", "configuration_sha256", "environment_sha256", "network"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "configuration_sha256": {"$ref": "#/$defs/digest"},
        "environment_sha256": {"$ref": "#/$defs/digest"},
        "network": {"const": "disabled"}
      }
    },
    "input_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "source_set"],
      "properties": {
        "authority": {"$ref": "#/$defs/hash"},
        "source_set": {"$ref": "#/$defs/hash"},
        "prior_state": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
      }
    },
    "output_root": {"$ref": "#/$defs/hash"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactDigest"}, "minItems": 1},
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "sha256", "bytes"],
      "properties": {
        "logical_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "logical_root": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
      }
    }
  }
}
