{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikilean.invalid/brain/authority/schemas/attestation/validation-v1.json",
  "title": "WikiLean immutable validation attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attestation_id",
    "release_id",
    "validator",
    "checks",
    "result"
  ],
  "properties": {
    "schema": {"const": "wikilean.validation-attestation/v1"},
    "attestation_id": {"$ref": "#/$defs/hash"},
    "release_id": {"$ref": "#/$defs/hash"},
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "git_commit", "environment_sha256", "network"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "environment_sha256": {"$ref": "#/$defs/digest"},
        "network": {"const": "disabled"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]},
          "details": {"type": "string"}
        }
      }
    },
    "result": {"const": "pass"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
