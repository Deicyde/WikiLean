{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikilean.invalid/brain/authority/schemas/reducer-config/v1.json",
  "title": "WikiLean Brain reducer configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "external_node_cap", "cell_attach_kinds", "layout"],
  "properties": {
    "schema": {"const": "wikilean.brain-reducer-config/v1"},
    "external_node_cap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cell_attach_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["generalization", "special_case", "invocation", "related"]
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "iterations"],
      "properties": {
        "enabled": {"type": "boolean"},
        "iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
