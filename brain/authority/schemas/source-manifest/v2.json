{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikilean.invalid/brain/authority/schemas/source-manifest/v2.json",
  "title": "WikiLean source manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_manifest_id",
    "source",
    "source_kind",
    "pin",
    "objects",
    "license",
    "acquisition",
    "normalization"
  ],
  "properties": {
    "schema": {"const": "wikilean.source-manifest/v2"},
    "source_manifest_id": {"$ref": "#/$defs/hash"},
    "source": {"$ref": "#/$defs/name"},
    "source_kind": {
      "enum": ["acquired_dataset", "curated_git_tree", "sealed_snapshot"]
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": [
            "git_commit",
            "content_sha256",
            "dataset_revision",
            "http_etag",
            "database_snapshot"
          ]
        },
        "value": {"type": "string", "minLength": 1, "maxLength": 512},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "git_commit"}}
          },
          "then": {
            "properties": {"value": {"pattern": "^[0-9a-f]{40}$"}}
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "content_sha256"}}
          },
          "then": {
            "properties": {"value": {"pattern": "^[0-9a-f]{64}$"}}
          }
        },
        {
          "if": {"required": ["tree"]},
          "then": {"properties": {"type": {"const": "git_commit"}}}
        }
      ]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceObject"}
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "redistribution"],
      "properties": {
        "expression": {"type": "string", "minLength": 1},
        "redistribution": {"enum": ["allowed", "restricted", "link-only", "unknown"]},
        "attribution": {"type": ["string", "null"]},
        "notice": {"type": ["string", "null"]}
      }
    },
    "acquisition": {"$ref": "#/$defs/tool"},
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "tool", "inputs", "outputs"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "tool": {"$ref": "#/$defs/tool"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/name"}
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/name"}
        }
      }
    },
    "previous_source_manifest_id": {
      "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "expected_semantic_effects"],
      "properties": {
        "summary": {"type": "string"},
        "expected_semantic_effects": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acquired_at": {"type": "string", "format": "date-time"},
        "upstream_uri": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source_kind": {"const": "curated_git_tree"}}},
      "then": {
        "properties": {
          "pin": {
            "required": ["type", "value", "tree"],
            "properties": {"type": {"const": "git_commit"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "sourceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "roles",
        "path",
        "media_type",
        "sha256",
        "bytes",
        "redistribution"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["raw", "normalized", "receipt"]}
        },
        "path": {
          "type": "string",
          "pattern": "^objects/sha256/[0-9a-f]{64}$"
        },
        "media_type": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "redistribution": {"enum": ["allowed", "restricted", "link-only", "unknown"]}
      }
    }
  }
}
