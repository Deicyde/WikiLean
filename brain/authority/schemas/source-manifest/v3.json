{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikilean.invalid/brain/authority/schemas/source-manifest/v3.json",
  "title": "WikiLean source manifest v3",
  "$comment": "The Python authority validator is normative. It additionally recomputes identities, enforces canonical ordering, and cross-validates referenced receipt, lineage, parent-manifest, and request-preimage contents when verifying an offline-pack/v3 closure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_manifest_id",
    "source",
    "source_kind",
    "pin",
    "objects",
    "license",
    "acquisition",
    "normalization"
  ],
  "properties": {
    "schema": {"const": "wikilean.source-manifest/v3"},
    "source_manifest_id": {"$ref": "#/$defs/hash"},
    "source": {"$ref": "#/$defs/name"},
    "source_kind": {
      "enum": ["acquired_dataset", "curated_git_tree", "sealed_snapshot"]
    },
    "pin": {"$ref": "#/$defs/pin"},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceObject"}
    },
    "license": {"$ref": "#/$defs/license"},
    "acquisition": {"$ref": "#/$defs/tool"},
    "normalization": {"$ref": "#/$defs/normalization"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "previous_source_manifest_id": {
      "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "expected_semantic_effects"],
      "properties": {
        "summary": {"type": "string"},
        "expected_semantic_effects": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acquired_at": {"type": "string", "format": "date-time"},
        "upstream_uri": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["source_kind"],
        "properties": {"source_kind": {"const": "curated_git_tree"}}
      },
      "then": {
        "not": {"required": ["evidence"]},
        "properties": {
          "pin": {
            "required": ["type", "value", "tree"],
            "properties": {"type": {"const": "git_commit"}}
          }
        }
      },
      "else": {"required": ["evidence"]}
    },
    {
      "if": {
        "required": ["source_kind"],
        "properties": {"source_kind": {"const": "acquired_dataset"}}
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "acquisition_receipt_ids": {"minItems": 1},
              "request_parameter_preimages": {"minItems": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "mediaType": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": [
            "git_commit",
            "content_sha256",
            "dataset_revision",
            "http_etag",
            "database_snapshot"
          ]
        },
        "value": {"type": "string", "minLength": 1, "maxLength": 512},
        "tree": {"$ref": "#/$defs/gitCommit"}
      },
      "allOf": [
        {
          "if": {"required": ["type"], "properties": {"type": {"const": "git_commit"}}},
          "then": {"properties": {"value": {"$ref": "#/$defs/gitCommit"}}}
        },
        {
          "if": {"required": ["type"], "properties": {"type": {"const": "content_sha256"}}},
          "then": {"properties": {"value": {"$ref": "#/$defs/digest"}}}
        },
        {
          "if": {"required": ["tree"]},
          "then": {"properties": {"type": {"const": "git_commit"}}}
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "redistribution"],
      "properties": {
        "expression": {"type": "string", "minLength": 1},
        "redistribution": {"enum": ["allowed", "restricted", "link-only", "unknown"]},
        "attribution": {"type": ["string", "null"]},
        "notice": {"type": ["string", "null"]}
      }
    },
    "sourceObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "roles",
        "path",
        "media_type",
        "sha256",
        "bytes",
        "redistribution"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["raw", "normalized", "receipt"]}
        },
        "path": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{64}$"},
        "media_type": {"$ref": "#/$defs/mediaType"},
        "sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "redistribution": {"enum": ["allowed", "restricted", "link-only", "unknown"]}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "tool", "inputs", "outputs"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "tool": {"$ref": "#/$defs/tool"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}
        }
      }
    },
    "requestPreimage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters_sha256", "bytes", "media_type"],
      "properties": {
        "parameters_sha256": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "media_type": {"$ref": "#/$defs/mediaType"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_receipt_ids",
        "normalization_lineage_id",
        "request_parameter_preimages"
      ],
      "properties": {
        "acquisition_receipt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hash"}
        },
        "normalization_lineage_id": {"$ref": "#/$defs/hash"},
        "request_parameter_preimages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requestPreimage"}
        }
      }
    }
  }
}
