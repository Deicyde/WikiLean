{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikilean.invalid/brain/authority/schemas/acquisition-receipt/v2.json",
  "title": "WikiLean acquisition receipt v2 with explicit attempts",
  "$comment": "The Python authority validator is normative. V2 retains every attempt, counts actual attempts, and requires exactly one final success for every unique request descriptor. V1 remains unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "acquisition_receipt_id",
    "source",
    "upstream_uri",
    "pin",
    "tool",
    "requests",
    "batch",
    "outputs",
    "audit",
    "attempts"
  ],
  "properties": {
    "schema": {
      "const": "wikilean.acquisition-receipt/v2"
    },
    "acquisition_receipt_id": {
      "$ref": "#/$defs/hash"
    },
    "source": {
      "$ref": "#/$defs/name"
    },
    "upstream_uri": {
      "$ref": "#/$defs/authorityUri"
    },
    "pin": {
      "$ref": "#/$defs/pin"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "request_set_root",
        "requests_total",
        "requests_succeeded",
        "requests_failed"
      ],
      "properties": {
        "status": {
          "const": "complete"
        },
        "request_set_root": {
          "$ref": "#/$defs/hash"
        },
        "requests_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requests_succeeded": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requests_failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/objectDigest"
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquired_at"
      ],
      "properties": {
        "acquired_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_index",
          "outcome",
          "response_sha256",
          "response_bytes"
        ],
        "properties": {
          "request_index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "response_sha256": {
            "$ref": "#/$defs/digest"
          },
          "response_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pin": {
            "properties": {
              "type": {
                "const": "content_sha256"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outputs": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "authorityUri": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2048,
      "pattern": "^(?:https|d1|postgresql|git\\+https)://[^\\u0000-\\u0020\\u007f?#]+$",
      "not": {
        "pattern": "^(?:https|d1|postgresql|git\\+https)://[^/?#]*@"
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "parameters_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "http_get",
            "http_post",
            "database_query",
            "snapshot_export"
          ]
        },
        "uri": {
          "$ref": "#/$defs/authorityUri"
        },
        "parameters_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "git_commit",
            "content_sha256",
            "dataset_revision",
            "http_etag",
            "database_snapshot"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tree": {
          "$ref": "#/$defs/gitCommit"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "git_commit"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/gitCommit"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "content_sha256"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tree"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "git_commit"
              }
            }
          }
        }
      ]
    },
    "objectDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "sha256",
        "bytes",
        "media_type"
      ],
      "properties": {
        "object": {
          "$ref": "#/$defs/name"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        }
      }
    }
  }
}
