    "bridge": {"library": "<id>", "declaration": "<the lemma the connection needs>", "why": "<what it adds>"},
    "witness": "<why the declaration alone does not give the passage>"},
   {"item": "<item>", "target": "absence", "action": "overturn",
    "locations": [{"library": "<id>", "declaration": "<name>", "relation": "exactMatch",
                   "rank": 1, "confidence": "high", "clauses": ["{{simple_clause}}"],
                   "instantiation": "<…>", "tests": {"r2": "<…>", "r3": "<…>"},
                   "note": "", "witness": "<why>"}],
    "witness": "<what you searched that the worker did not>"},
   {"item": "<item>", "target": "absence", "action": "uphold",
    "queries": ["<query a>", "<query b>", "<query c>"],
    "query_clauses": {"<query a>": ["c1"], "<query b>": ["c2"], "<query c>": ["c1", "c2"]},
    "special_case": {"reason": "<why no special case of either conjunct is stated>"},
    "witness": "<what you searched, and why nothing states a clause>"},
   {"item": "<item>", "target": "coverage", "action": "confirm",
    "part_relations": {"<a part's location_key>": "broadMatch", "<another's>": "closeMatch"},
    "part_conventions": {"<another's>": "encoding"},
