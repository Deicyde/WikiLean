```json
{"schema": "{{schema}}", "mode": "{{mode}}",
 "run_id": "{{run_id}}", "task_id": "<your task id>",
 "source_id": "<from the manifest>", "source_sha": "<from the manifest>",
 "layer_sha256": "<from the manifest>", "renderer": "<from the manifest>",
 "universe": "{{universe}}", "universe_sha256": "{{universe_sha256}}",
 "verdicts": [
   {"item": "<item>", "target": "location", "location_key": "<from the manifest>",
    "action": "confirm", "clauses": ["{{simple_clause}}"],
    "tests": {"r2": "<how the passage follows from the declaration>", "r3": "<why it needs nothing more>"},
    "witness": "<quoted signature fragment and why it states the passage>"},
   {"item": "<item>", "target": "location", "location_key": "<from the manifest>",
