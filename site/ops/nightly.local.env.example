# Copy to site/ops/nightly.local.env (gitignored) and replace the placeholders.
# launchd reads this file through brain-nightly.sh; ordinary interactive-shell
# exports are not inherited by a scheduled LaunchAgent.

WIKILEAN_PYTHON="$REPO/.venv/bin/python3"
WIKILEAN_MATHLIB=/absolute/path/to/mathlib4
BRAIN_MATHLIB_CHECKOUT=/absolute/path/to/mathlib4/Mathlib
export WIKILEAN_PYTHON WIKILEAN_MATHLIB BRAIN_MATHLIB_CHECKOUT

# Optional: enable community-edge reduction from one already acquired and
# verified D1 bundle. Nightly moderation never acquires D1 data itself.
# WIKILEAN_COMMUNITY_HARVEST=1
# WIKILEAN_D1_SNAPSHOT_BUNDLE=/absolute/path/to/sealed-d1-snapshot-bundle
# export WIKILEAN_COMMUNITY_HARVEST WIKILEAN_D1_SNAPSHOT_BUNDLE

# Required by brain-promote-release.sh, not by the shadow nightly. Use a private
# (0700), backed-up directory outside every WikiLean checkout. Initialize it
# once with brain_deploy_journal.py init; never rotate roots around an incomplete attempt.
WIKILEAN_BRAIN_RECEIPT_DIR=/absolute/path/to/wikilean-brain-deploy-receipts
# Store for immutable non-Brain Worker asset baselines. A promotion receives
# one exact baseline ID/root explicitly; this path is used by the freeze step.
WIKILEAN_BRAIN_PUBLIC_BASELINE_STORE=/absolute/path/to/wikilean-public-baselines
# External content-addressed store for the exact sealed public/Worker/config bytes and
# raw read-only production probes retained by promoter --dry-run.
WIKILEAN_BRAIN_PROMOTER_DRY_RUN_STORE=/absolute/path/to/wikilean-promoter-dry-runs
# External, content-addressed store for immutable 11-file P1B review bundles.
# Used by brain_activation_bundle.py freeze; never place it under a checkout or site/out.
WIKILEAN_BRAIN_ACTIVATION_BUNDLE_STORE=/absolute/path/to/wikilean-activation-bundles
# Explicit reviewed executables for activation context/freeze. The recorder discards the
# caller PATH and pins child resolution to these paths.
WIKILEAN_BRAIN_GIT=/absolute/path/to/git
WIKILEAN_BRAIN_NODE=/absolute/path/to/node
WIKILEAN_BRAIN_NPM=/absolute/path/to/npm
export WIKILEAN_BRAIN_RECEIPT_DIR WIKILEAN_BRAIN_PUBLIC_BASELINE_STORE
export WIKILEAN_BRAIN_PROMOTER_DRY_RUN_STORE
export WIKILEAN_BRAIN_ACTIVATION_BUNDLE_STORE
export WIKILEAN_BRAIN_GIT WIKILEAN_BRAIN_NODE WIKILEAN_BRAIN_NPM

# Optional: only needed when WIKILEAN_BRAIN_AGENTS=1.
# WIKILEAN_BRAIN_AGENT_PYTHON=/absolute/path/to/venv/bin/python3
# export WIKILEAN_BRAIN_AGENT_PYTHON
