# Copy to site/ops/nightly.local.env (gitignored) and replace the placeholders.
# launchd reads this file through brain-nightly.sh; ordinary interactive-shell
# exports are not inherited by a scheduled LaunchAgent.

WIKILEAN_PYTHON="$REPO/.venv/bin/python3"
BRAIN_MATHLIB_CHECKOUT=/absolute/path/to/mathlib4/Mathlib
export WIKILEAN_PYTHON BRAIN_MATHLIB_CHECKOUT

# Required by brain-promote-release.sh, not by the shadow nightly. Use a private
# (0700), backed-up directory outside every WikiLean checkout. Initialize it
# once with brain_deploy_journal.py init; never rotate roots around an incomplete attempt.
WIKILEAN_BRAIN_RECEIPT_DIR=/absolute/path/to/wikilean-brain-deploy-receipts
# Store for immutable non-Brain Worker asset baselines. A promotion receives
# one exact baseline ID/root explicitly; this path is used by the freeze step.
WIKILEAN_BRAIN_PUBLIC_BASELINE_STORE=/absolute/path/to/wikilean-public-baselines
export WIKILEAN_BRAIN_RECEIPT_DIR WIKILEAN_BRAIN_PUBLIC_BASELINE_STORE

# Optional: only needed when WIKILEAN_BRAIN_AGENTS=1.
# WIKILEAN_BRAIN_AGENT_PYTHON=/absolute/path/to/venv/bin/python3
# export WIKILEAN_BRAIN_AGENT_PYTHON
